<?xml version="1.0"?>

<odoo>
    <data>
        <record id="parser_action" model="ir.actions.act_window">
            <field name="name">Parsers</field>
            <field name="res_model">parser.parser</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <record id = "parser_view_tree" model = "ir.ui.view">
            <field name = "name">parser.view.tree</field>
            <field name = "model">parser.parser</field>
            <field name = "arch" type = "xml">
                <tree string = "Parsers">
                    <field name = "name" string = "Name"/>
                    <field name = "parse_method" string = "Parse method"/>
                </tree>
            </field>
        </record>

        <record id = "parser_view_form" model = "ir.ui.view">
            <field name = "name">parser.view.form</field>
            <field name = "model">parser.parser</field>
            <field name = "arch" type = "xml">
                <form string = "Parser">
                    <sheet>
                        <group>
                            <h1>
                                <field string = "Name" name = "name"/>
                            </h1>
                        </group>
                        <group>
                            <field name = "parse_method"/>
                        </group>
                        <notebook string = "Python" attrs = "{'invisible': [('parse_method','!=','Python')]}">
                            <page string = "Detect function">
                                <field name = "detect_func" widget = "ace"/>
                            </page>
                            <page string = "Parse function">
                                <field name = "parse_func" widget = "ace"/>
                            </page>
                            <page string = "Requests">
                                <field name = "request_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>