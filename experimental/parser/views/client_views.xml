<?xml version="1.0"?>

<odoo>
    <data>
        <record id="client_action" model="ir.actions.act_window">
            <field name="name">Clients</field>
            <field name="res_model">parser.client</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <record id = "client_view_tree" model = "ir.ui.view">
            <field name = "name">client.view.tree</field>
            <field name = "model">parser.client</field>
            <field name = "arch" type = "xml">
                <tree string = "Clients">
                    <field name = "name"/>
                    <field name = "key_expires"/>
                </tree>
            </field>
        </record>

        <record id = "client_view_form" model = "ir.ui.view">
            <field name = "name">client.view.form</field>
            <field name = "model">parser.client</field>
            <field name = "arch" type = "xml">
                <form string = "Client">
                    <sheet>
                        <group>
                            <h1>
                                Client
                                <separator/>
                                <field string = "Name" name = "name"/>
                            </h1>
                        </group>
                        <group>
                            <field name = "key_expires"/>
                        </group>
                        <group>
                            <field name = "authorize_key"/>
                        </group>
                        <notebook>
                            <page string = "Requests">
                                <field name = "request_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>